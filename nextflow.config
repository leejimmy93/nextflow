/*
 * Nextflow configuration file for fine-mapping pipeline
 */

// Default parameters
params {
    // Input files
    sumstats = null
    genotype_prefix = null

    // Analysis parameters
    sig_threshold = 5e-8
    window_size = 500000  // 500kb
    coverage = 0.95
    min_abs_corr = 0.5
    L = 1

    // Output
    outdir = "results"

    // Optional
    ref_genome = null
}

// Process configuration
process {
    // Default resources
    cpus = 1
    memory = '4 GB'
    time = '2h'

    // Process-specific resources
    withName: LOAD_SUMSTATS {
        cpus = 1
        memory = '8 GB'
    }

    withName: CALCULATE_LD {
        cpus = 4
        memory = '8 GB'
    }

    withName: RUN_SUSIE {
        cpus = 1
        memory = '16 GB'
        time = '4h'
    }
}

// Execution profiles
profiles {
    standard {
        process.executor = 'local'
    }

    cluster {
        process.executor = 'slurm'
        process.queue = 'batch'
    }

    awsbatch {
        process.executor = 'awsbatch'
        process.queue = 'nextflow-base-v1'
        aws.region = 'us-east-1'
        aws.batch.cliPath = '/root/miniconda/bin/aws'
        aws.batch.jobRole = 'arn:aws:iam::335777049998:role/ecsTaskExecutionRole'
    }

    docker {
        docker.enabled = true
        process.container = 'bioinformatics/gwas-tools:latest'
    }

    conda {
        conda.enabled = true
        conda.useMamba = false
        process.conda = '/home/sagemaker-user/.conda/envs/gwas_tutorial'
    }
}

// Report configuration
report {
    enabled = true
    overwrite = true
    file = "${params.outdir}/reports/execution_report.html"
}

timeline {
    enabled = true
    overwrite = true
    file = "${params.outdir}/reports/timeline.html"
}

trace {
    enabled = true
    overwrite = true
    file = "${params.outdir}/reports/trace.txt"
}

dag {
    enabled = true
    overwrite = true
    file = "${params.outdir}/reports/pipeline_dag.html"
}
